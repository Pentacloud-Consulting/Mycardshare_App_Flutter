<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- ═══════════════════════════════════════════════════
	     PRIVACY USAGE DESCRIPTIONS (NSUsageDescription keys)
	     Required: App Store rejection if missing for used APIs
	     ═══════════════════════════════════════════════════ -->

	<key>NSCameraUsageDescription</key>
	<string>My Card Share uses the camera to scan business cards and QR codes for quick contact sharing.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>My Card Share uses your photo library to let you upload a profile photo and banner for your digital business card.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>My Card Share saves your generated QR codes and card images to your photo library.</string>

	<key>NSContactsUsageDescription</key>
	<string>My Card Share saves business contacts you receive directly to your iOS Contacts app.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>My Card Share uses the microphone for video features in card profiles.</string>

	<key>NFCReaderUsageDescription</key>
	<string>My Card Share reads NFC business cards to instantly view and save contact information.</string>

	<key>NSUserNotificationsUsageDescription</key>
	<string>My Card Share sends notifications for new connection requests, messages, and card view alerts.</string>

	<key>NSFaceIDUsageDescription</key>
	<string>My Card Share uses Face ID for quick and secure account access.</string>

	<!-- ═══════════════════════════════════════════════════
	     NFC — CoreNFC (ISO 14443 / NDEF reading)
	     ═══════════════════════════════════════════════════ -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
		<string>TAG</string>
	</array>

	<!-- ═══════════════════════════════════════════════════
	     URL SCHEMES — deep links (mycardshare://)
	     ═══════════════════════════════════════════════════ -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mycardshare.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mycardshare</string>
			</array>
		</dict>
		<!-- Google Sign-In reverse client ID (replace at build time via Xcode env) -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.google.reverseClientId</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>

	<!-- ═══════════════════════════════════════════════════
	     LSApplicationQueriesSchemes — external apps we open
	     ═══════════════════════════════════════════════════ -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>whatsapp</string>
		<string>instagram</string>
		<string>twitter</string>
		<string>x</string>
		<string>linkedin</string>
		<string>fb</string>
		<string>tiktok</string>
		<string>snapchat</string>
		<string>youtube</string>
		<string>maps</string>
		<string>comgooglemaps</string>
		<string>googlegmail</string>
	</array>

	<!-- ═══════════════════════════════════════════════════
	     App Transport Security — HTTPS only for backend
	     ═══════════════════════════════════════════════════ -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>mycardshare.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>firebaseapp.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- ═══════════════════════════════════════════════════
	     BUNDLE METADATA
	     ═══════════════════════════════════════════════════ -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>My Card Share</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>my_card_share</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
