# ╔══════════════════════════════════════════════════════════════════════╗
# ║  My Card Share — iOS Podfile                                         ║
# ║  Minimum iOS: 15.5  (required by google_mlkit_text_recognition)      ║
# ║  Run `pod install` on Mac after `flutter pub get`                    ║
# ╚══════════════════════════════════════════════════════════════════════╝

platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ── permission_handler macros ────────────────────────────────────────
  # Enables only the permissions actually used in My Card Share.
  # Set to 0 to disable; 1 to enable. Unused ones must be 0 to strip
  # unnecessary entitlements from the App Store submission.
  pod 'permission_handler_apple', :path => '.symlinks/plugins/permission_handler_apple/ios', :modular_headers => true

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Set iOS deployment target for all pods to match our minimum
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # ── permission_handler compile-time flags ──────────────────────
      # Enable only permissions that My Card Share actually uses.
      # Disabling unused ones avoids unnecessary App Store permission prompts.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        ## ✅ Camera — scan QR codes / business cards
        'PERMISSION_CAMERA=1',
        ## ✅ Photos — upload / save profile photos & QR images
        'PERMISSION_PHOTOS=1',
        ## ✅ Contacts — save received business cards to Contacts
        'PERMISSION_CONTACTS=1',
        ## ✅ Notifications — connection requests, messages, card-view alerts
        'PERMISSION_NOTIFICATIONS=1',
        ## ✅ NFC — read NFC business card chips
        'PERMISSION_NFC=1',
        ## ❌ Bluetooth — not used
        'PERMISSION_BLUETOOTH=0',
        ## ❌ Location — not used
        'PERMISSION_LOCATION=0',
        ## ❌ Calendar — not used
        'PERMISSION_CALENDAR=0',
        ## ❌ Microphone — disabled unless video profiles added
        'PERMISSION_MICROPHONE=0',
        ## ❌ Speech recognition — not used
        'PERMISSION_SPEECH_RECOGNIZER=0',
        ## ❌ Reminders — not used
        'PERMISSION_REMINDERS=0',
        ## ❌ Media library — not used
        'PERMISSION_MEDIA_LIBRARY=0',
        ## ❌ Sensors — not used
        'PERMISSION_SENSORS=0',
        ## ❌ Assistant (Siri) — not used
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end
end
